# ============================================================
# ecoStock — Environment Variables
# ============================================================
# HOW TO USE:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in your actual values in .env
#   3. NEVER commit .env to Git (add it to .gitignore)

# --- App Settings ---
APP_NAME="ecoStock"
APP_VERSION="0.1.0"
DEBUG=True                          # Set to False in production

# --- Database (PostgreSQL) ---
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/ecostock_db

# --- Redis (for task queues and caching) ---
REDIS_URL=redis://localhost:6379/0

# --- Security ---
SECRET_KEY=your-super-secret-key-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60      # How long login tokens stay valid

# --- ecoStock Business Logic Settings ---
# How many days before expiry to trigger a discount alert
DISCOUNT_ALERT_DAYS=3

# How many hours before expiry to trigger food bank routing
FOOD_BANK_ALERT_HOURS=24

# Default discount percentage tiers (comma-separated: days:discount%)
# Example: 3 days left = 20% off, 1 day left = 50% off
DISCOUNT_TIERS="3:20,2:35,1:50"
